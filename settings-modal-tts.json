{
  "env": {
    "ANTHROPIC_BASE_URL": "https://<你的Modal用户名>--bubu-gpt-oss-serve.modal.run",
    "ANTHROPIC_AUTH_TOKEN": "<你的bubu-API密钥，部署modal-deploy时自己设定的sk-bubu-开头那串>",
    "ANTHROPIC_MODEL": "bubu-gpt-oss",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "bubu-gpt-oss",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "bubu-gpt-oss",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "bubu-gpt-oss",
    "ANTHROPIC_SMALL_FAST_MODEL": "bubu-gpt-oss",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16384",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "HTTPS_PROXY": "http://127.0.0.1:7890",
    "NO_PROXY": "localhost,127.0.0.1",
    "VOX_REMOTE": "autodl-vox"
  },
  "model": "bubu-gpt-oss",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/tts-hook/speak_last_reply.py\""
          }
        ]
      }
    ]
  }
}
