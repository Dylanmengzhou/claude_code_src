{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_MODEL": "gpt-oss-agent:32k",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-oss-agent:32k",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-oss-agent:32k",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-oss-agent:32k",
    "ANTHROPIC_SMALL_FAST_MODEL": "gpt-oss-agent:32k",
    "ANTHROPIC_CUSTOM_HEADERS": "",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "VOX_REMOTE": "autodl-vox"
  },
  "model": "gpt-oss-agent:32k",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
